# Copy to .env and fill in. Never commit .env.
TRADER_MODE=dry_run            # dry_run (research only) | paper | live
TRADER_LIVE_AUTHORIZATION=     # live needs exactly: i-authorize-live-trading
TRADER_KILL_SWITCH=0           # 1 halts all new orders (or create ./KILL_SWITCH)
TRADER_ALLOW_0DTE=false
TRADER_JOURNAL_PATH=journal/trades.jsonl
RH_ACCOUNT_NUMBER=
NEWS_API_KEY=
MARKET_DATA_API_KEY=
DATABASE_URL=
ALERT_WEBHOOK_URL=
